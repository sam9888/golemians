NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Any long random string. Required header (x-admin-key) to call
# PATCH/GET /api/admin/submissions to approve/allocate WL spots.
ADMIN_API_KEY=change-me-to-a-long-random-string

# X (Twitter) API - for auto-pulling the latest tweet every 24h.
# Optional: if left blank, the site falls back to the manual
# daily_tweets rotation instead of breaking.
X_BEARER_TOKEN=your-app-only-bearer-token-from-developer.x.com
X_USERNAME=golemians

# Any long random string. Protects the cron endpoint from being called
# by anyone other than Vercel's scheduler. Optional but recommended -
# if unset, the endpoint has no auth check.
CRON_SECRET=change-me-to-a-long-random-string

# Required. Signs wallet sign-in session cookies (lib/session.js). Generate
# with `openssl rand -hex 32`. If unset, wallet sign-in will fail.
SESSION_SECRET=change-me-to-a-long-random-string

# Required. The Golemians NFT (ERC721) contract address, checked via
# balanceOf() to gate city creation and PvP (10+ NFTs, see lib/pvpLogic.js).
# The collection lives on Robinhood Chain, not Ethereum mainnet - lib/web3Connect.js
# and app/api/pvp/verify-nft/route.js query https://rpc.mainnet.chain.robinhood.com.
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Informational only right now - no route reads this yet, since the RPC URL
# above is hardcoded. Robinhood Chain mainnet's chain ID is 4663.
NEXT_PUBLIC_NFT_CHAIN_ID=4663

# Required for the Arena (GOLEMIANS: LAST ONE STANDING). Shared secret the
# Colyseus match server (game-server/) presents as a Bearer token when it
# calls POST /api/arena/settle server-to-server. Must match GAME_SERVER_SECRET
# in game-server/.env exactly. Generate with `openssl rand -hex 32`.
GAME_SERVER_SECRET=change-me-to-a-long-random-string

# Required for the Arena. Public WebSocket URL of the deployed Colyseus game
# server that the browser client (lib/arena/arenaClient.js) connects to.
# Use ws://localhost:2567 for local dev against `npm run dev` in game-server/.
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567
