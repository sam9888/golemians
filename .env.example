NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Any long random string. Required header (x-admin-key) to call
# PATCH/GET /api/admin/submissions to approve/allocate WL spots.
ADMIN_API_KEY=change-me-to-a-long-random-string

# X (Twitter) API - for auto-pulling the latest tweet every 24h.
# Optional: if left blank, the site falls back to the manual
# daily_tweets rotation instead of breaking.
X_BEARER_TOKEN=your-app-only-bearer-token-from-developer.x.com
X_USERNAME=golemians

# Any long random string. Protects the cron endpoint from being called
# by anyone other than Vercel's scheduler. Optional but recommended -
# if unset, the endpoint has no auth check.
CRON_SECRET=change-me-to-a-long-random-string
